<!DOCTYPE html>
<html>
<head>
  <title>Edit Task</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body class="default">
  <main class="container">
    <h1>Edit Task</h1>

    <form action="/editTask/<%= task._id %>" method="POST">
      <label>Task Title</label>
      <input type="text" name="title" value="<%= task.title %>" required>

      <label>Class Name</label>
      <input type="text" name="className" value="<%= task.className %>" required>

      <label>Due Date</label>
      <input type="date" name="dueDate" value="<%= task.dueDate %>" required>

      <label>Estimated Hours</label>
      <input type="number" name="estimatedHours" value="<%= task.estimatedHours %>" required>

      <div class="button-group">
        <button type="submit">Save Changes</button>
        <a href="/" class="secondary-btn">Cancel</a>
      </div>
    </form>
  </main>

  <script src="/theme.js"></script>
</body>
</html>