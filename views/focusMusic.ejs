<!DOCTYPE html>
<html>
<head>
  <title>Focus Music</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body class="default">
  <main class="container">
    <h1>Focus Music</h1>
    <p>Search for study music based on your mood, subject, or vibe.</p>

    <form action="/focusMusic" method="POST">
      <label>What kind of study music do you want?</label>

      <input 
        type="text" 
        name="searchTerm" 
        placeholder="lofi study, piano focus, coding music..."
        value="<%= searchTerm %>"
        required
      >

      <div class="button-group">
        <button type="submit">Find Music</button>
        <a href="/" class="secondary-btn">Back Home</a>
      </div>
    </form>

    <% if (tracks !== null) { %>
      <h2>Results for "<%= searchTerm %>"</h2>

      <% if (tracks.length === 0) { %>
        <p>No tracks found. Try another search.</p>
      <% } else { %>

        <div class="tracks-container">
          <% tracks.forEach(track => { %>
            <div class="track-card">
              <% if (track.image) { %>
                <img 
                  src="<%= track.image %>" 
                  alt="Album cover for <%= track.name %>"
                >
              <% } %>

              <h3><%= track.name %></h3>
              <p>By <%= track.artist %></p>

              <a href="<%= track.link %>" target="_blank">
                Open on Spotify
              </a>

              <% if (track.preview) { %>
                <audio controls class="audio-preview">
                  <source src="<%= track.preview %>" type="audio/mpeg">
                  Your browser does not support the audio element.
                </audio>
              <% } else { %>
                <p class="no-preview">No preview available</p>
              <% } %>
            </div>
          <% }) %>
        </div>

      <% } %>
    <% } %>
  </main>

  <script src="/theme.js"></script>
</body>
</html>