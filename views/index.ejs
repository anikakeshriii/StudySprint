<!DOCTYPE html>
<html>
<head>
  <title>StudySprint</title>
  <link rel="stylesheet" href="/styles.css">
</head>


<body class="default">

  <div class="settings-menu">
    <button id="settingsBtn" type="button">⚙</button>

    <div class="dropdown">
      <label>Choose Theme</label>
      <select id="themeSelect">
        <option value="default">Purple</option>
        <option value="green">Green</option>
        <option value="pink">Pink</option>
        <option value="blue">Blue</option>
        <option value="sunset">Sunset</option>
        <option value="dark">Dark</option>
      </select>
    </div>
  </div>

  <main class="container">
    <h1>StudySprint</h1>
    <p>Your student task tracker and study motivation dashboard.</p>

    <div class="nav">
      <a href="/addTask">Add Task</a>
      <a href="/motivation">Motivation</a>
      <a href="/focusMusic">Focus Music</a>
      <a href="/pomodoro">Pomodoro</a>
    </div>

    <%
      const todayDashboard = new Date();
      todayDashboard.setHours(0, 0, 0, 0);

      let dueTodayCount = 0;
      let dueThisWeekCount = 0;
      let totalHours = 0;
      let completedCount = 0;

      // WEEKLY SUMMARY VARIABLES
      let weekCompleted = 0;
      let weekRemaining = 0;
      let weekHours = 0;

      const endOfWeek = new Date(todayDashboard);
      endOfWeek.setDate(todayDashboard.getDate() + 7);

      tasks.forEach(task => {
        const dateParts = task.dueDate.split("-");
        const taskDueDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
        taskDueDate.setHours(0, 0, 0, 0);

        const daysUntilDue = Math.round((taskDueDate - todayDashboard) / (1000 * 60 * 60 * 24));

        if (daysUntilDue === 0) dueTodayCount++;
        if (daysUntilDue >= 0 && daysUntilDue <= 7) dueThisWeekCount++;

        totalHours += (Number(task.estimatedHours) || 0) + ((Number(task.estimatedMinutes) || 0) / 60);

        if (task.completed) completedCount++;

        // WEEKLY LOGIC
        if (taskDueDate >= todayDashboard && taskDueDate <= endOfWeek) {
          if (task.completed) {
            weekCompleted++;
          } else {
            weekRemaining++;
            weekHours += Number(task.estimatedHours) || 0;
          }
        }
      });

      const progressPercent = tasks.length === 0
        ? 0
        : Math.round((completedCount / tasks.length) * 100);

      const activeTasks = tasks.filter(task => !task.completed);
      const completedTasks = tasks.filter(task => task.completed);

      function getTaskDateInfo(task) {
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const parts = task.dueDate.split("-");
        const due = new Date(parts[0], parts[1] - 1, parts[2]);
        due.setHours(0, 0, 0, 0);

        const diffDays = Math.round((due - today) / (1000 * 60 * 60 * 24));

        let dueMessage = "";

        if (diffDays < 0) {
          dueMessage = `Overdue by ${Math.abs(diffDays)} day${Math.abs(diffDays) === 1 ? "" : "s"}`;
        } else if (diffDays === 0) {
          dueMessage = "Due today";
        } else if (diffDays === 1) {
          dueMessage = "Due tomorrow";
        } else {
          dueMessage = `Due in ${diffDays} days`;
        }

        return { due, diffDays, dueMessage };
      }
    %>

    <section class="dashboard-grid">
      <div class="dashboard-card">
        <span class="dashboard-icon">📅</span>
        <h3><%= dueTodayCount %></h3>
        <p>Due Today</p>
      </div>

      <div class="dashboard-card">
        <span class="dashboard-icon">⏳</span>
        <h3><%= dueThisWeekCount %></h3>
        <p>Due This Week</p>
      </div>

      <div class="dashboard-card">
        <span class="dashboard-icon">🧠</span>
        <h3><%= totalHours.toFixed(1) %></h3>
        <p>Estimated Hours</p>
      </div>

      <div class="completion-section">
        <p><strong>Progress: <%= progressPercent %>% completed</strong></p>

        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= progressPercent + '%' %>"></div>
        </div>
      </div>
    </section>

    <!-- 🔥 WEEKLY SUMMARY -->
    <div class="weekly-summary">
      <h3>This Week</h3>
      <p>✔ <%= weekCompleted %> completed</p>
      <p>⏳ <%= weekRemaining %> remaining</p>
      <p>🧠 <%= weekHours %> hours left</p>

      <% if (weekRemaining === 0 && weekCompleted > 0) { %>
        <p class="celebration-message">🔥 You finished everything this week!</p>
      <% } %>
    </div>

    <div class="task-controls">
  <input 
    type="text" 
    id="taskSearch" 
    placeholder="Search tasks by title or class..."
  >

  <select id="taskFilter">
    <option value="all">All Tasks</option>
    <option value="today">Due Today</option>
    <option value="week">Due This Week</option>
    <option value="overdue">Overdue</option>
    <option value="completed">Completed</option>
  </select>
</div>

    <h2>Upcoming Tasks</h2>

    <% if (activeTasks.length === 0) { %>
      <p>🎉 No upcoming tasks — you’re all caught up!</p>
    <% } else { %>

      <% activeTasks.forEach(task => { %>

        <%
          const info = getTaskDateInfo(task);
          const due = info.due;
          const diffDays = info.diffDays;
          const dueMessage = info.dueMessage;
        %>

        <div 
            class="card task-card"
            data-title="<%= task.title.toLowerCase() %>"
            data-class="<%= task.className.toLowerCase() %>"
            data-status="<%= diffDays < 0 ? 'overdue' : diffDays === 0 ? 'today' : diffDays <= 7 ? 'week' : 'future' %>"
        >

          <% if (diffDays < 0) { %>
            <span class="badge due-overdue">❌ Overdue</span>
          <% } else if (diffDays === 0) { %>
            <span class="badge due-today">🚨 Due Today</span>
          <% } else if (diffDays === 1) { %>
            <span class="badge due-tomorrow">⚠ Due Tomorrow</span>
          <% } %>

          <h3><%= task.title %></h3>

          <p><strong>Class:</strong> <%= task.className %></p>

          <p><strong>Due:</strong>
            <%= due.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p class="due-message"><strong><%= dueMessage %></strong></p>

          <p>
            <strong>Estimated Time:</strong>
            <%= task.estimatedHours || 0 %> hr
            <%= task.estimatedMinutes || 0 %> min
          </p>

          <div class="task-actions">
            <form action="/toggleComplete" method="POST">
              <input type="hidden" name="id" value="<%= task._id %>">
              <button type="submit" class="complete-btn">Complete</button>
            </form>

            <a href="/editTask/<%= task._id %>" class="edit-btn">Edit</a>

            <form action="/deleteTask" method="POST" class="delete-form">
              <input type="hidden" name="id" value="<%= task._id %>">
              <button type="submit" class="delete-btn">Delete</button>
            </form>
          </div>

        </div>

      <% }) %>

    <% } %>

    <h2>Completed Tasks</h2>

    <% if (completedTasks.length === 0) { %>
      <p>No completed tasks yet.</p>
    <% } else { %>

      <% completedTasks.forEach(task => { %>

        <%
          const info = getTaskDateInfo(task);
          const due = info.due;
        %>

        <div 
            class="card completed-task task-card"
            data-title="<%= task.title.toLowerCase() %>"
            data-class="<%= task.className.toLowerCase() %>"
            data-status="completed"
        >

          <h3><%= task.title %></h3>

          <p><strong>Class:</strong> <%= task.className %></p>

          <p><strong>Due:</strong>
            <%= due.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p>
            <strong>Estimated Time:</strong>
            <%= task.estimatedHours || 0 %> hr
            <%= task.estimatedMinutes || 0 %> min
          </p>

          <div class="task-actions">
            <form action="/toggleComplete" method="POST">
              <input type="hidden" name="id" value="<%= task._id %>">
              <button type="submit" class="complete-btn">Undo</button>
            </form>

            <a href="/editTask/<%= task._id %>" class="edit-btn">Edit</a>

            <form action="/deleteTask" method="POST" class="delete-form">
              <input type="hidden" name="id" value="<%= task._id %>">
              <button type="submit" class="delete-btn">Delete</button>
            </form>
          </div>

        </div>

      <% }) %>

    <% } %>

  </main>

  <script src="/theme.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

<script>
  const totalTasks = <%= tasks.length %>;
  const completedTasks = <%= completedTasks.length %>;

  if (totalTasks > 0 && totalTasks === completedTasks) {
    confetti({
      particleCount: 160,
      spread: 80,
      origin: { y: 0.6 }
    });
  }
</script>

<script>
  const taskSearch = document.getElementById("taskSearch");
  const taskFilter = document.getElementById("taskFilter");

  function filterTasks() {
    const searchValue = taskSearch.value.toLowerCase();
    const filterValue = taskFilter.value;

    document.querySelectorAll(".task-card").forEach(card => {
      const title = card.dataset.title;
      const className = card.dataset.class;
      const status = card.dataset.status;

      const matchesSearch =
        title.includes(searchValue) || className.includes(searchValue);

      const matchesFilter =
        filterValue === "all" ||
        status === filterValue ||
        (filterValue === "week" && (status === "today" || status === "week"));

      if (matchesSearch && matchesFilter) {
        card.style.display = "block";
      } else {
        card.style.display = "none";
      }
    });
  }

  taskSearch.addEventListener("input", filterTasks);
  taskFilter.addEventListener("change", filterTasks);
</script>

</body>
</html>