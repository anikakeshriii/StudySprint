<!DOCTYPE html>
<html>
<head>
  <title>StudySprint</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body class="default">

  <div class="settings-menu">
    <button id="settingsBtn" type="button">⚙</button>

    <div class="dropdown">
      <label>Choose Theme</label>
      <select id="themeSelect">
        <option value="default">Purple</option>
        <option value="green">Green</option>
        <option value="pink">Pink</option>
        <option value="blue">Blue</option>
        <option value="sunset">Sunset</option>
        <option value="dark">Dark</option>
      </select>
    </div>
  </div>

  <main class="container">
    <h1>StudySprint</h1>
    <p>Your student task tracker and study motivation dashboard.</p>

    <div class="nav">
      <a href="/addTask">Add Task</a>
      <a href="/motivation">Motivation</a>
      <a href="/focusMusic">Focus Music</a>
      <a href="/pomodoro">Pomodoro</a>
    </div>

    <%
      const todayDashboard = new Date();
      todayDashboard.setHours(0, 0, 0, 0);

      let dueTodayCount = 0;
      let dueThisWeekCount = 0;
      let totalHours = 0;
      let completedCount = 0;

      tasks.forEach(task => {
        const dateParts = task.dueDate.split("-");
        const taskDueDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
        taskDueDate.setHours(0, 0, 0, 0);

        const daysUntilDue = Math.round((taskDueDate - todayDashboard) / (1000 * 60 * 60 * 24));

        if (daysUntilDue === 0) {
          dueTodayCount++;
        }

        if (daysUntilDue >= 0 && daysUntilDue <= 7) {
          dueThisWeekCount++;
        }

        totalHours += Number(task.estimatedHours) || 0;

        if (task.completed) {
          completedCount++;
        }
      });

      const progressPercent = tasks.length === 0
        ? 0
        : Math.round((completedCount / tasks.length) * 100);
    %>

    <section class="dashboard-grid">
      <div class="dashboard-card">
        <span class="dashboard-icon">📅</span>
        <h3><%= dueTodayCount %></h3>
        <p>Due Today</p>
      </div>

      <div class="dashboard-card">
        <span class="dashboard-icon">⏳</span>
        <h3><%= dueThisWeekCount %></h3>
        <p>Due This Week</p>
      </div>

      <div class="dashboard-card">
        <span class="dashboard-icon">🧠</span>
        <h3><%= totalHours %></h3>
        <p>Estimated Hours</p>
      </div>

      <div class="completion-section">
        <p><strong>Progress: <%= progressPercent %>% completed</strong></p>

        <div class="progress-bar">
          <div class="progress-fill" style="width: <%= progressPercent + '%' %>"></div>
        </div>
      </div>
    </section>

    <h2>Upcoming Tasks</h2>

    <% if (tasks.length === 0) { %>
      <p>No tasks yet. Add your first assignment!</p>
    <% } else { %>

      <% tasks.forEach(task => { %>

        <%
          const today = new Date();
          today.setHours(0, 0, 0, 0);

          const parts = task.dueDate.split("-");
          const due = new Date(parts[0], parts[1] - 1, parts[2]);
          due.setHours(0, 0, 0, 0);

          const diffDays = Math.round((due - today) / (1000 * 60 * 60 * 24));

          let dueMessage = "";

          if (diffDays < 0) {
            dueMessage = `Overdue by ${Math.abs(diffDays)} day${Math.abs(diffDays) === 1 ? "" : "s"}`;
          } else if (diffDays === 0) {
            dueMessage = "Due today";
          } else if (diffDays === 1) {
            dueMessage = "Due tomorrow";
          } else {
            dueMessage = `Due in ${diffDays} days`;
          }
        %>

        <div class="card <%= task.completed ? 'completed-task' : '' %>">

          <% if (diffDays < 0) { %>
            <span class="badge due-overdue">❌ Overdue</span>
          <% } else if (diffDays === 0) { %>
            <span class="badge due-today">🚨 Due Today</span>
          <% } else if (diffDays === 1) { %>
            <span class="badge due-tomorrow">⚠ Due Tomorrow</span>
          <% } %>

          <h3><%= task.title %></h3>

          <p><strong>Class:</strong> <%= task.className %></p>

          <p><strong>Due:</strong>
            <%= due.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p class="due-message"><strong><%= dueMessage %></strong></p>

          <p><strong>Estimated Hours:</strong> <%= task.estimatedHours %></p>

          <div class="task-actions">
            <form action="/toggleComplete" method="POST">
                <input type="hidden" name="id" value="<%= task._id %>">

                <% if (task.completed) { %>
                <button type="submit" class="complete-btn">Mark Incomplete</button>
                <% } else { %>
                <button type="submit" class="complete-btn">Mark Complete</button>
                <% } %>
            </form>

            <a href="/editTask/<%= task._id %>" class="edit-btn">Edit</a>

            <form action="/deleteTask" method="POST">
                <input type="hidden" name="id" value="<%= task._id %>">

                <button type="submit" class="delete-btn" onclick="return confirm('Delete this task?')">
                Delete
                </button>
            </form>
            </div>

        </div>

      <% }) %>

    <% } %>
  </main>

  <script src="/theme.js"></script>
</body>
</html>