<!DOCTYPE html>
<html>
<head>
  <title>StudySprint</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body class="default">

  <!-- SETTINGS -->
  <div class="settings-menu">
    <button id="settingsBtn" type="button">⚙</button>

    <div class="dropdown">
      <label>Choose Theme</label>
      <select id="themeSelect">
        <option value="default">Purple</option>
        <option value="green">Green</option>
        <option value="pink">Pink</option>
        <option value="blue">Blue</option>
        <option value="sunset">Sunset</option>
        <option value="dark">Dark</option>
      </select>
    </div>
  </div>

  <main class="container">

    <h1>StudySprint</h1>
    <p>Your student task tracker and study motivation dashboard.</p>

    <!-- NAV -->
    <div class="nav">
      <a href="/addTask">Add Task</a>
      <a href="/tasks">View Tasks</a>
      <a href="/motivation">Motivation</a>
      <a href="/focusMusic">Focus Music</a>
      <a href="/pomodoro">Pomodoro Method</a>
    </div>

    <h2>Upcoming Tasks</h2>

    <% if (tasks.length === 0) { %>
      <p>No tasks yet. Add your first assignment!</p>

    <% } else { %>

      <% tasks.forEach(task => { %>

        <%
          const today = new Date();
          today.setHours(0, 0, 0, 0);

          const parts = task.dueDate.split("-");
          const due = new Date(parts[0], parts[1] - 1, parts[2]);
          due.setHours(0, 0, 0, 0);

          const diffDays = Math.round((due - today) / (1000 * 60 * 60 * 24));
        %>

        <div class="card">

          <% if (diffDays === 0) { %>
            <span class="badge due-today">🚨 Due Today</span>
          <% } else if (diffDays === 1) { %>
            <span class="badge due-tomorrow">⚠ Due Tomorrow</span>
          <% } %>

          <h3><%= task.title %></h3>

          <p><strong>Class:</strong> <%= task.className %></p>

          <p><strong>Due:</strong> 
            <%= due.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p><strong>Priority:</strong> <%= task.priority %></p>

        </div>

      <% }) %>

    <% } %>

  </main>

  <script src="/theme.js"></script>

</body>
</html>